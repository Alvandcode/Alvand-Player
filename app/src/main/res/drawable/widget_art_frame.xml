<?xml version="1.0" encoding="utf-8"?>
<!-- کاور: فقط گوشه‌های سمتِ شروع گرد است تا لبهٔ داخلیِ کاور تیز بماند (مثل مرجع).
     نسخهٔ راست‌به‌چپ همین فایل با گوشه‌های راست در drawable-ldrtl است. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners
                android:bottomLeftRadius="18dp"
                android:topLeftRadius="18dp" />
            <solid android:color="@color/widget_art_placeholder" />
            <!-- اندازهٔ درونی ۹۶dp تا با قاب هم‌اندازه باشد و کشیده نشود -->
            <size
                android:width="96dp"
                android:height="96dp" />
        </shape>
    </item>
</layer-list>
