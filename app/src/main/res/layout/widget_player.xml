<?xml version="1.0" encoding="utf-8"?>
<!--
  ویجت هوم‌اسکرین الوند — کارت کپسولی:
  کاور مربعی چپ + پنل راست با عنوان/خواننده، نوار پیشرفت و ۵ کنترل.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="horizontal">

    <!-- کاور: گوشهٔ چپ در خودِ بیت‌مپ گرد می‌شود (سازگار با همهٔ APIها) -->
    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="96dp"
        android:layout_height="match_parent"
        android:background="@drawable/widget_art_frame"
        android:contentDescription="@string/widget_cover"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_art_placeholder_icon" />

    <LinearLayout
        android:id="@+id/widget_panel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="9dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <!-- عنوان + نشان اپ در گوشهٔ بالا -->
        <LinearLayout
            android:id="@+id/widget_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_name"
                    android:textColor="@color/widget_title"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_desc"
                    android:textColor="@color/widget_sub"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/widget_brand"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/widget_name"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_brand_badge" />
        </LinearLayout>

        <!-- نوار پیشرفت + زمان سپری‌شده -->
        <LinearLayout
            android:id="@+id/widget_seek_zone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- نقطهٔ ابتدای نوار؛ در RemoteViews ساده‌تر از clip است و همیشه دیده می‌شود -->
            <ImageView
                android:id="@+id/widget_seek_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_progress_dot" />

            <!-- بدون style تا به تم لانچر وابسته نشود؛ progressDrawable صریح است -->
            <ProgressBar
                android:id="@+id/widget_progress"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_weight="1"
                android:indeterminate="false"
                android:max="1000"
                android:progress="0"
                android:progressDrawable="@drawable/widget_progress" />

            <TextView
                android:id="@+id/widget_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/widget_time_zero"
                android:textColor="@color/widget_time"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- کنترل‌ها: تکرار، قبلی، پخش، بعدی، علاقه‌مندی -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_repeat"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_btn_bg"
                android:contentDescription="@string/widget_repeat"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_repeat" />

            <ImageButton
                android:id="@+id/widget_prev"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_btn_bg"
                android:contentDescription="@string/widget_prev"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_prev" />

            <ImageButton
                android:id="@+id/widget_toggle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.3"
                android:background="@drawable/widget_btn_bg"
                android:contentDescription="@string/widget_play"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_play" />

            <ImageButton
                android:id="@+id/widget_next"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_btn_bg"
                android:contentDescription="@string/widget_next"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_next" />

            <ImageButton
                android:id="@+id/widget_fav"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_btn_bg"
                android:contentDescription="@string/widget_fav"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_fav" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
